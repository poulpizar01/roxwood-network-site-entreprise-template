// ENTREPRISE (personnalisable) — tables propres à ce site. Le générateur et la base sont déclarés dans socle.prisma.
// Règles :
// - noms de tables en français et en snake_case (@@map), colonnes aussi (@map) ;
// - un compte se référence par `compteId Int @map("compte_id")`, sans relation Prisma vers Compte (socle.prisma ne se
//   modifie pas) ; ce qui doit disparaître avec le compte est effacé dans avantSuppressionCompte (src/entreprise/index.ts) ;
// - après chaque modification : docker compose exec app npx prisma migrate dev --name <description>, puis committer
//   le dossier créé dans prisma/migrations/.

// Agenda partagé : visibilité, invitations et règles dans entreprise/agenda-regles.ts et routes/agenda.ts
model EvenementAgenda {
  id               Int      @id @default(autoincrement())
  compteId         Int?     @map("compte_id") // auteur ; null : compte supprimé (événement partagé gardé)
  auteurNom        String   @default("") @map("auteur_nom") @db.VarChar(64)
  titre            String   @db.VarChar(80)
  jour             DateTime @db.Date // premier jour de l'événement
  jourFin          DateTime @map("jour_fin") @db.Date // dernier jour ; égal à `jour` pour un événement d'un seul jour
  heureDebut       String?  @map("heure_debut") @db.VarChar(5) // HH:MM, heure de Paris ; absentes sur plusieurs jours (pas d'horaire)
  heureFin         String?  @map("heure_fin") @db.VarChar(5)
  notes            String   @default("") @db.VarChar(500)
  typeId           Int?     @map("type_id") // classement (couleur) ; type supprimé : « Sans type »
  type             TypeAgenda? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  // destiné à : « perso » (l'auteur et ses invités), « tous », ou « grade » (selon les droits exacts réglés par grade, agenda-regles.ts)
  destination      String   @default("perso") @db.VarChar(10)
  destinationGrade String?  @map("destination_grade") @db.VarChar(20)
  // absence (congé, maladie…) : null = événement normal ; sinon « en_attente » ou « approuve », jamais changée après
  // la création (le détail va dans le titre ou les notes) ; un refus retire l'événement (routes/agenda.ts)
  statutAbsence    String?  @map("statut_absence") @db.VarChar(10)
  invitations      InvitationAgenda[]
  creeLe           DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe            DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  @@index([compteId, jour])
  @@index([destination, jour])
  @@index([statutAbsence])
  @@map("evenements_agenda")
}

model InvitationAgenda {
  id               Int             @id @default(autoincrement())
  evenementId      Int             @map("evenement_id")
  evenement        EvenementAgenda @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  discordId        String          @map("discord_id") @db.VarChar(22)
  nom              String          @db.VarChar(130)
  discordSalonId   String?         @map("discord_salon_id") @db.VarChar(22)
  discordMessageId String?         @map("discord_message_id") @db.VarChar(22)
  prevenu          String          @default("") @db.VarChar(10) // ticket | prive | '' (non prévenu)

  @@unique([evenementId, discordId])
  @@index([discordId, evenementId])
  @@map("agenda_invitations")
}

// Types d'événements de l'agenda : simple classement (nom, couleur), gérés par la permission « agenda-types »
model TypeAgenda {
  id          Int    @id @default(autoincrement())
  nom         String @unique @db.VarChar(40)
  couleur     String @db.VarChar(7)
  position    Int    @default(0)
  evenements  EvenementAgenda[]

  @@map("agenda_types")
}

// Accès à l'agenda par grade (page Grades). Chaque liste contient les grades destinataires exacts autorisés.
// Pour l'équipe, la consultation est distincte du droit combiné de créer, modifier et supprimer.
model AgendaDroitsGrade {
  gradeCle      String   @id @map("grade") @db.VarChar(20)
  consulter     String[] @default([])
  creer         String[] @default([])
  modifier      String[] @default([])
  consulterTous Boolean  @default(false) @map("consulter_tous")
  gererTous     Boolean  @default(false) @map("gerer_tous")

  @@map("agenda_droits_grades")
}

// Ressources humaines : la fiche employé, source de vérité de l'identité (routes/rh.ts). Les autres modules (ventes,
// tableur, DOT) ne gardent que employeId et lisent ici nom, grade et statut. Une fiche n'est jamais supprimée : un départ
// la passe « inactif », son historique reste rattaché. Un employé n'a pas forcément de compte sur le site : le lien
// avec un compte se fait par l'ID Discord.
model Employe {
  id                     Int       @id @default(autoincrement())
  idUnique               String    @map("id_unique") @db.VarChar(40) // identifiant métier saisi par RH (ex. 42)
  idUniqueNormalise      String    @unique @map("id_unique_normalise") @db.VarChar(40) // unicité sans casse
  idProvisoire           Boolean   @default(false) @map("id_provisoire") // PROV-… : à remplacer par le vrai
  prenom                 String    @default("") @db.VarChar(60)
  nom                    String    @default("") @db.VarChar(60)
  telephone              String    @default("") @db.VarChar(30) // donnée sensible (permission rh-sensible)
  rib                    String    @default("") @db.VarChar(60) // donnée sensible (permission rh-sensible)
  discordId              String?   @unique @map("discord_id") @db.VarChar(22)
  discordPseudo          String    @default("") @map("discord_pseudo") @db.VarChar(100) // pseudo envoyé avec les ventes
  discordPseudoNormalise String?   @unique @map("discord_pseudo_normalise") @db.VarChar(100)
  gradeCle               String    @map("grade") @db.VarChar(20) // clé d'un grade du site (page Grades)
  statut                 String    @default("actif") @db.VarChar(8) // actif | inactif
  dateArrivee            DateTime? @map("date_arrivee") @db.Date
  dateDepart             DateTime? @map("date_depart") @db.Date
  creeLe                 DateTime  @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe                  DateTime  @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  @@index([statut, gradeCle])
  @@map("employes")
}

// Candidature reçue du bot Discord (webhook recruitment.updated), une ligne par ticket : un renvoi du même ticket ne
// crée jamais une deuxième fiche. resultat : creee | existante | refusee (« à traiter », réglage manquant…) |
// attente (embauche constatée en jeu, à approuver) | ecartee (refusée dans Discord) | ecartee_rh (écartée dans RH :
// un renvoi du bot ne la recrée pas). « reponses » (qui peuvent contenir téléphone et RIB) n'est gardé que pour un
// ticket en suspens, 30 jours au plus.
model ArriveeBot {
  id        Int      @id @default(autoincrement())
  ticketId  String   @unique @map("ticket_id") @db.VarChar(100)
  discordId String   @default("") @map("discord_id") @db.VarChar(30)
  nomRecu   String   @default("") @map("nom_recu") @db.VarChar(130)
  resultat  String   @db.VarChar(10)
  motif     String   @default("") @db.VarChar(400)
  employeId Int?     @map("employe_id")
  reponses  Json?
  accepteLe String   @default("") @map("accepte_le") @db.VarChar(40)
  evenementLe DateTime? @map("evenement_le") @db.Timestamptz(6) // date (sentAt) du dernier événement du bot appliqué à ce ticket
  recuLe    DateTime @default(now()) @map("recu_le") @db.Timestamptz(6)

  @@index([recuLe(sort: Desc)])
  @@map("rh_arrivees_bot")
}

// ---------- Factures & runs (entreprise/facture.ts, entreprise/run.ts) ----------

// Facture de l'entreprise : commande boutique validée côté bot (webhook order.updated, renvoyée à chaque changement —
// statut, régénération — rattachée par idBot, jamais recréée), paiement constaté en jeu par le monitoring FiveM
// (webhook monitoring.invoice, idBot nul : pas d'identifiant propre à l'événement, dédoublonnage laissé au socle,
// comme pour `runs`), ou saisie à la main depuis la gestion (idBot nul, compteId l'auteur). `details` ne garde que ce
// qui varie selon la source (articles de la commande…) : jamais interrogé en SQL, seulement affiché. employeId :
// rattachement au quota de facturation (page Quota), seulement pour un paiement constaté en jeu (monitoring.invoice,
// même principe que `runs` : la fiche RH de l'employé qui a enregistré le paiement, jamais le client).
model Facture {
  id             Int      @id @default(autoincrement())
  source         String   @db.VarChar(12) // order | monitoring | manuel
  idBot          String?  @unique @map("id_bot") @db.VarChar(100) // identifiant du bot (orderId…) : idempotence des renvois
  numeroFacture  String   @default("") @map("numero_facture") @db.VarChar(100)
  clientNom      String   @default("") @map("client_nom") @db.VarChar(200)
  sousTotal      Int      @default(0) @map("sous_total")
  livraison      Int      @default(0)
  reduction      Int      @default(0)
  total          Int      @default(0)
  statutPaiement String   @default("") @map("statut_paiement") @db.VarChar(20)
  details        Json?
  compteId       Int?     @map("compte_id") // saisie depuis le site ; null = reçue du bot
  employeId      Int?     @map("employe_id") // qui a enregistré le paiement en jeu (monitoring.invoice uniquement) ; quota de facturation
  avoirDeId      Int?     @unique @map("avoir_de_id") // renseigné seulement sur l'avoir : facture d'origine qu'il annule (montants négatifs) ; unique pour empêcher deux avoirs sur la même facture en cas de double requête simultanée
  dateFacture    DateTime  @default(now()) @map("date_facture") @db.Timestamptz(6) // date de la facture : reçue du bot, prise à défaut sur l'instant de réception ; saisie à la main sinon ; modifiable ensuite dans les deux cas (routes/compta.ts) — jamais réécrite par un renvoi du bot (changement de statut)
  dateEcheance   DateTime? @map("date_echeance") @db.Timestamptz(6) // date d'échéance de paiement, facultative : jamais fournie par le bot, saisie et modifiée depuis la gestion
  majLe          DateTime  @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  @@index([source, dateFacture(sort: Desc)])
  @@index([dateFacture(sort: Desc)])
  @@index([compteId])
  @@index([employeId])
  @@map("factures")
}

// Vente d'objet en jeu (« run »), reçue du bot Discord entreprise : événement monitoring.sale, un message par vente
// annoncée dans le salon de monitoring. Rattachée à la fiche RH du vendeur (ID Discord, sinon pseudo) quand elle
// existe ; sans fiche, gardée telle quelle (entreprise/run.ts). jobId identifie le métier RP du vendeur, jamais la
// transaction : aucune clé d'idempotence propre à cette table, le dédoublonnage des renvois du bot est déjà fait par
// le socle (empreinte du corps, socle/routes/webhooks.ts).
model Run {
  id               Int      @id @default(autoincrement())
  jobId            String   @default("") @map("job_id") @db.VarChar(100)
  vendeurNom       String   @default("") @map("vendeur_nom") @db.VarChar(120) // tel qu'envoyé par le bot
  vendeurDiscordId String?  @map("vendeur_discord_id") @db.VarChar(22)
  employeId        Int?     @map("employe_id")
  itemLabel        String   @default("") @map("item_label") @db.VarChar(120)
  quantite         Int      @default(0)
  totalPrice       Int      @default(0) @map("total_price")
  companyShare     Int      @default(0) @map("company_share")
  description      String   @default("") @db.VarChar(500) // texte brut du bot, pour vérifier un rattachement douteux
  creeLe           DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([creeLe(sort: Desc)])
  @@index([employeId])
  @@map("runs")
}

// Objectif hebdomadaire de runs par grade (part entreprise, « company_share »), réglé dans Ressources humaines →
// Run. Un grade sans ligne n'a pas d'objectif (0 = jamais affiché en retard).
model RunsQuotaGrade {
  gradeCle String @id @map("grade") @db.VarChar(20)
  quota    Int    @default(0)

  @@map("runs_quota_grades")
}

// Quota hebdomadaire de montant facturé par grade, réglé dans la fiche du grade (page Grades). Un grade sans ligne
// n'a pas de quota (0 = jamais affiché en retard). Consultation : page Quota (entreprise/facture.ts, classementFactures).
model FacturesQuotaGrade {
  gradeCle String @id @map("grade") @db.VarChar(20)
  quota    Int    @default(0)

  @@map("factures_quota_grades")
}

// Rémunération par grade du site : salaire de base, paie à l'heure, indépendants et cumulables. Un grade sans ligne a
// les valeurs par défaut (pas de salaire, pas de paie à l'heure). Salaire de base réglé page Paie (entreprise/paie.ts) ;
// paie à l'heure toujours réglée en base seulement (pas d'UI), lue par stats/paie-horaire.ts.
model RemunerationGrade {
  gradeCle     String  @id @map("grade") @db.VarChar(20)
  salaireFixe  Int?    @map("salaire_fixe")
  salaireActif Boolean @default(false) @map("salaire_actif")
  tauxHoraire  Int     @default(0) @map("taux_horaire") // $ par heure de service (relevé Tablettes) ; 0 = pas de paie à l'heure

  @@map("remunerations_grades")
}

// Prime par palier de quota (page Paie), run ou facture : seul le palier le plus haut atteint compte (comme le barème
// d'imposition, jamais cumulé avec les paliers inférieurs) ; si un grade a des paliers des deux domaines, les deux
// primes s'additionnent (entreprise/paie.ts, calculerPaie).
model PrimePalierGrade {
  id       Int    @id @default(autoincrement())
  gradeCle String @map("grade") @db.VarChar(20)
  domaine  String @db.VarChar(10) // run | facture
  seuil    Int
  prime    Int

  @@unique([gradeCle, domaine, seuil])
  @@index([gradeCle, domaine])
  @@map("primes_palier_grades")
}

// ---------- Comptabilité (routes/compta.ts) ----------

// Relevé collé (Tablettes) : le navigateur le découpe, le serveur revalide et garde CHAQUE import (rien n'est écrasé ;
// réinitialiser ou retirer une ligne enregistre un nouvel import). Seul le plus récent est lu.
model ImportCompta {
  id        Int      @id @default(autoincrement())
  type      String   @default("tablettes") @db.VarChar(20)
  colonnes  Json
  lignes    Json
  compteId  Int?     @map("compte_id") // auteur ; null si son compte a été supprimé
  importeLe DateTime @default(now()) @map("importe_le") @db.Timestamptz(6)

  @@index([type, importeLe(sort: Desc)])
  @@index([compteId])
  @@map("compta_imports")
}

// Recette exceptionnelle, dépense déductible ou retrait, saisis à la main pour la déclaration DOT d'une semaine
// (lundi de la semaine, calendrier Paris) : chaque semaine a son propre journal, jamais mélangé à la suivante. Un
// mouvement ne se crée ou ne se supprime que sur la semaine en cours, et seulement si elle n'est pas verrouillée
// (DeclarationDot).
model EcritureDot {
  id           Int      @id @default(autoincrement())
  type         String   @db.VarChar(10) // recette | depense | retrait
  semaine      DateTime @db.Date
  dateEcriture String   @default("") @map("date_ecriture") @db.VarChar(10) // JJ/MM/AAAA
  justificatif String   @db.VarChar(200)
  montant      Int
  compteId     Int?     @map("compte_id")
  creeLe       DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([semaine, type])
  @@index([compteId])
  @@map("compta_dot_ecritures")
}

// Déclaration DOT d'une semaine, verrouillée (figée) : une fois présente, la semaine devient lecture seule — plus
// aucun mouvement, prime ou solde bancaire ne la change, et son résumé ne recalcule plus rien (même si le barème ou
// le relevé Tablettes changent ensuite). `resume`, `salaries` et `ecritures` reprennent exactement la forme des
// réponses JSON de GET /api/compta/dot/resume, /salaries et /ecritures au moment du verrouillage — autonomes, donc
// toujours lisibles même si une table liée change de forme plus tard. Verrouillage manuel (« Valider la déclaration »,
// compteId renseigné) ou automatique (planifiée la semaine suivante si personne ne l'a fait, compteId nul) :
// entreprise/verrouillage-dot.ts.
model DeclarationDot {
  semaine  DateTime @id @db.Date
  statut   String   @db.VarChar(10) // validee | auto
  figeeLe  DateTime @default(now()) @map("figee_le") @db.Timestamptz(6)
  compteId Int?     @map("compte_id") // qui a validé ; null si verrouillage automatique
  resume   Json
  salaries Json
  ecritures Json

  @@map("compta_dot_declarations")
}

// Barème d'imposition de la DOT (fixé par l'organisme du serveur RP, le même pour toutes les entreprises) : rempli par
// la migration, à corriger en base s'il change.
model BaremeImposition {
  id                Int   @id @default(autoincrement())
  seuilMin          Int   @map("seuil_min")
  seuilMax          Int   @map("seuil_max")
  taux              Float
  salaireMaxEmploye Int   @map("salaire_max_employe")
  salaireMaxPatron  Int   @map("salaire_max_patron")
  primeMaxEmploye   Int   @map("prime_max_employe")
  primeMaxPatron    Int   @map("prime_max_patron")

  @@map("dot_bareme_imposition")
}

// Barème de l'impôt sur la richesse de la DOT (même organisme, même principe que BaremeImposition) : son taux
// s'ajoute à celui de BaremeImposition (pas un second impôt séparé) et s'applique au même bénéfice imposable ; la
// tranche choisie dépend du solde bancaire de l'entreprise (reglages, clé « dot.solde_bancaire »), saisi à la main.
model BaremeRichesse {
  id       Int   @id @default(autoincrement())
  seuilMin Int   @map("seuil_min")
  seuilMax Int   @map("seuil_max")
  taux     Float

  @@map("dot_bareme_richesse")
}

// Prime versée à un employé pour une semaine de la DOT (saisie à la main dans le tableau des salariés) : une ligne par
// employé et par semaine (lundi de la semaine, calendrier Paris). Entre dans « Montant total des primes » du résumé DOT.
model PrimeEmployeSemaine {
  id        Int      @id @default(autoincrement())
  employeId Int      @map("employe_id")
  semaine   DateTime @db.Date
  montant   Int      @default(0)
  majLe     DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  @@unique([employeId, semaine])
  @@map("compta_dot_primes")
}

// Images de la marque remplacées dans Paramètres → Apparence (routes/apparence.ts) : une ligne par image réglée ; sans ligne,
// l'image livrée avec le site est servie. Les deux fichiers (grande version, miniature) sont sur le stockage.
model ApparenceImage {
  cle      String   @id @db.VarChar(20) // logo, icone, partage (routes/apparence.ts)
  cleImage String   @map("cle_image") @db.VarChar(200)
  url      String   @db.VarChar(512)
  cleMini  String   @map("cle_mini") @db.VarChar(200)
  urlMini  String   @map("url_mini") @db.VarChar(512)
  compteId Int?     @map("compte_id") // qui l'a remplacée ; null si son compte a été supprimé
  majLe    DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  @@map("apparence_images")
}

// Fichier du stockage qui n'est plus utilisé (image de la marque remplacée ou rétablie) : effacé par la tâche de
// nettoyage (entreprise/images-retirees.ts) ; un échec garde la ligne et son erreur, réessai au passage suivant.
model ImageRetiree {
  id      Int      @id @default(autoincrement())
  cle     String   @db.VarChar(200)
  url     String   @db.VarChar(512)
  cleMini String   @map("cle_mini") @db.VarChar(200)
  urlMini String   @map("url_mini") @db.VarChar(512)
  erreur  String?  @db.VarChar(300) // dernier échec de suppression sur le stockage
  creeLe  DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe   DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  @@index([majLe])
  @@map("images_retirees")
}

// Membres en service (services.ts) : une ligne par service, d'après les prises et fins de service envoyées par le bot
// Discord (événement monitoring.duty). fin vide = en service.
model Service {
  id           Int       @id @default(autoincrement())
  serviceId    String    @unique @map("service_id") @db.VarChar(64) // tiré de la personne et de l'heure (un renvoi du bot ne double rien)
  employeNom   String    @default("") @map("employe_nom") @db.VarChar(120) // nom de la fiche RH, sinon celui envoyé par le bot
  discordId    String?   @map("discord_id") @db.VarChar(22) // identifiant Discord envoyé par le bot
  employeId    Int?      @map("employe_id")
  debut        DateTime  @db.Timestamptz(6)
  fin          DateTime? @db.Timestamptz(6)
  causeFin     String    @default("") @map("cause_fin") @db.VarChar(120)
  finSource    String    @default("") @map("fin_source") @db.VarChar(8) // bot | auto | doublon
  anomalie     String    @default("") @db.VarChar(20) // fin_sans_debut | debut_en_double | cloture_auto
  majLe        DateTime  @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  @@index([fin, debut])
  @@index([discordId, debut]) // chaque prise ou fin de service cherche les services de la personne
  @@index([employeId])
  @@index([anomalie, majLe])
  @@map("services")
}

// Réception des prises et fins de service (affichée dans Paramètres : preuve que l'abonnement du bot fonctionne).
model ServiceEtat {
  id               Int       @id @default(1)
  derniereLecture  DateTime? @map("derniere_lecture") @db.Timestamptz(6) // dernier événement reçu du bot
  nbReconnus       Int       @default(0) @map("nb_reconnus") // événements reçus

  @@map("services_etat")
}

// Sanction disciplinaire rattachée à une fiche RH (permission rh-sanctionner, en plus de rh-voir). Jamais modifiée :
// une sanction saisie par erreur se retire, elle ne se corrige pas. Visible par l'employé concerné dans Mon compte.
model Sanction {
  id        Int           @id @default(autoincrement())
  employeId Int           @map("employe_id")
  typeId    Int?          @map("type_id") // type supprimé : « Sans type » (onDelete: SetNull), comme les types d'agenda
  type      TypeSanction? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  note      String        @default("") @db.VarChar(500)
  compteId  Int?          @map("compte_id") // auteur ; null si compte supprimé
  auteurNom String        @default("") @map("auteur_nom") @db.VarChar(64)
  creeLe    DateTime      @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([employeId, creeLe(sort: Desc)])
  @@map("sanctions")
}

// Types de sanction : simple classement (nom, couleur), géré avec la permission rh-sanctionner — comme les types
// d'agenda (agenda-regles.ts).
model TypeSanction {
  id        Int        @id @default(autoincrement())
  nom       String     @unique @db.VarChar(40)
  couleur   String     @db.VarChar(7)
  position  Int        @default(0)
  sanctions Sanction[]

  @@map("types_sanction")
}
